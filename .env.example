# Сервер API для WhatsApp-бота (npm run server)
PORT=3000
HOST=0.0.0.0
# ключи доступа через запятую (бот шлёт X-API-Key: <ключ>); пусто — API открыт всем
# создать ключ: npm run api-key  (→ gr_…)
API_KEYS=
# запросов в минуту на ключ (без ключей — на IP); 0 — без лимита
RATE_LIMIT=60
# 1 — сервер за своим прокси (nginx, Render, Railway): IP клиента из X-Forwarded-For
TRUST_PROXY=0
# внешний адрес сервера для документации /docs (кнопка «Try it out»); пусто — тот же сервер
PUBLIC_URL=

# Куда npm run cap:copy копирует сборку приложения (папка www Capacitor-проекта)
# по умолчанию ~/myapp/www; путь — полный, без ~
# CAP_WWW=/home/user/myapp/www

# CLI лицензий: другие пути к закрытому ключу и базе клиентов
# GEOROMB_KEY=/path/to/private.jwk.json
# GEOROMB_DB=/path/to/issued.json
