# Сервер API для WhatsApp-бота (npm run server)
PORT=3000
HOST=0.0.0.0

# Куда npm run cap:copy копирует сборку приложения (папка www Capacitor-проекта)
# по умолчанию ~/myapp/www; путь — полный, без ~
# CAP_WWW=/home/user/myapp/www

# CLI лицензий: другие пути к закрытому ключу и базе клиентов
# GEOROMB_KEY=/path/to/private.jwk.json
# GEOROMB_DB=/path/to/issued.json
