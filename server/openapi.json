    "/api/v1/catalog": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Цвета профиля и стёкла",
        "security": [],
        "description": "Коды для color / defaultColor (colors.pvc — для type pvc, colors.alu — для type alu) и glass / defaultGlass. Бот может показать клиенту выбор по name; hex — примерный цвет для картинки.",
        "responses": {
          "200": {
            "description": "каталог",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "colors": {
                      "type": "object",
                      "properties": {
                        "pvc": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "hex": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "alu": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "hex": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "glass": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Ключ вида gr_… (выдаёт владелец сервера)"
      },
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "код ошибки"
          },
          "message": {
            "type": "string",
            "description": "что не так, по-русски"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "elements"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "default": "Проект"
          },
          "type": {
            "type": "string",
            "enum": [
              "pvc",
              "alu"
            ],
            "default": "pvc"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Element"
            }
          },
          "defaultColor": {
            "type": "string",
            "description": "цвет профиля для всех окон без своего color (коды — GET /api/v1/catalog, по type проекта)"
          },
          "defaultGlass": {
            "type": "string",
            "description": "стекло для всех окон без своего glass"
          }
        }
      },
      "Element": {
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "casement",
              "sliding",
              "sill"
            ],
            "default": "casement"
          },
          "width": {
            "type": "number",
            "minimum": 10,
            "maximum": 10000,
            "description": "мм (у окна от 100)"
          },
          "height": {
            "type": "number",
            "minimum": 10,
            "maximum": 10000,
            "description": "мм (у окна от 100)"
          },
          "qty": {
            "type": "number",
            "default": 1
          },
          "net": {
            "type": "boolean",
            "description": "москитная сетка"
          },
          "root": {
            "$ref": "#/components/schemas/Node"
          },
          "color": {
            "type": "string",
            "description": "цвет профиля (рамы): код из GET /api/v1/catalog → colors.pvc или colors.alu, по type проекта; без поля — белый",
            "example": "ral7016"
          },
          "glass": {
            "type": "string",
            "enum": [
              "clear",
              "bronze",
              "grey",
              "darkgrey",
              "green",
              "azur",
              "darkblue",
              "privablue"
            ],
            "description": "стекло; без поля — прозрачное"
          },
          "sill": {
            "type": "boolean",
            "description": "подоконник у окна"
          },
          "sillLen": {
            "type": "number",
            "description": "длина подоконника, м; без поля — ширина окна + 40 мм"
          },
          "sillWidth": {
            "type": "number",
            "description": "ширина (глубина) полки, см; по умолчанию 20"
          }
        }
      },
      "Node": {
        "type": "object",
        "description": "Часть окна (лист) или деление (ветка). Без kind: есть children — ветка, иначе лист.",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "leaf",
              "branch"
            ]
          },
          "fill": {
            "type": "string",
            "enum": [
              "glass",
              "panelV",
              "panelH"
            ],
            "default": "glass"
          },
          "opening": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "Turn",
                      "Tilt",
                      "TiltTurn",
                      "Door",
                      "Sliding",
                      "FixSliding"
                    ]
                  },
                  "hinge": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right",
                      "top",
                      "bottom"
                    ]
                  }
                }
              }
            ],
            "description": "null — глухая часть"
          },
          "inner": {
            "$ref": "#/components/schemas/Node",
            "description": "деление внутри створки (например, дверь: стекло сверху, панель снизу)"
          },
          "dir": {
            "type": "string",
            "enum": [
              "v",
              "h"
            ],
            "description": "v — части рядом слева направо, h — сверху вниз"
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "размеры частей в мм; без него — поровну"
          },
          "children": {
            "type": "array",
            "minItems": 2,
            "items": {
