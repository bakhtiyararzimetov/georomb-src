                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Service"
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Это описание",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1"
          }
        },
        "tags": [
          "Service"
        ]
      }
    },
