{
  "name": "georomb",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "description": "GeoRomb: расчёт окон (фронтенд на TypeScript + Capacitor), CLI лицензий (бэкенд для revoked.json на GitHub Pages) и API генерации PDF для WhatsApp-бота",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "npm run typecheck && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "typecheck": "tsc -p app/tsconfig.json && tsc -p backend/tsconfig.json && tsc -p server/tsconfig.json",
    "cap:copy": "node --env-file-if-exists=.env scripts/copy-to-capacitor.ts",
    "license": "node backend/src/cli.ts",
    "icons": "node scripts/make-icons.ts",
    "api-key": "node -e \"console.log('gr_' + require('node:crypto').randomBytes(24).toString('base64url'))\"",
    "server": "node --env-file-if-exists=.env --no-experimental-webstorage server/src/main.ts",
    "test": "node --no-experimental-webstorage --test server/test/ app/test/"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "pdf-lib": "^1.17.1",
    "swagger-ui-dist": "5.33.1"
  },
  "license": "UNLICENSED",
  "author": "Bakhtiyar Arzimetov",
  "engines": {
    "node": ">=26"
  }
}
